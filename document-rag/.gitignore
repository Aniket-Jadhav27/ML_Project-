# ─── Python / FastAPI git-ignore (document-rag/) ────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# ChromaDB runtime data (vector store — regenerated on upload)
chroma_db/

# User-uploaded files and extracted JSONs (private user data)
data/*.pdf
data/*_extracted.json
# Allow sample files to remain tracked
!data/document.pdf
!data/mgnrega_sample_report.pdf
!data/document.txt

# Secrets
.env
.env.*
!.env.example

# Misc
*.egg-info/
dist/
build/
.pytest_cache/
*.log
